// Build configuration for Pulse.
//
// Only non-secret values belong here. A Polymarket builder code is a public
// attribution identifier, so shipping it in the bundle is fine. A private key
// is NOT, and must never appear in this file or any other build input — the
// app reads keys only from the Keychain, at signing time.
//
// To set your own values, copy this file to Secrets.xcconfig (gitignored) and
// set them there, then point the project's configuration at it.

// Your 10-character Apple Developer Team ID.
// Xcode → Settings → Accounts → your account → the "Team ID" column, or
// developer.apple.com → Membership. This is not a secret: it ships inside
// every build. Setting it here covers all three targets at once, and
// survives regenerating the project.
DEVELOPMENT_TEAM = 49BZ7S974W

PRODUCT_BUNDLE_IDENTIFIER = com.pulse.polymarket

// Privy. Both of these are PUBLIC client identifiers and ship in the bundle.
//
// The App *Secret* (privy_app_secret_…) must never appear here, in Info.plist,
// or anywhere else in the app. It is a server-side credential: anything in the
// bundle can be extracted from a distributed IPA, and that secret can mint
// user tokens. The iOS SDK does not accept it and does not need it.
PRIVY_APP_ID = cmwyzm1k300wz0gl7b5np4ucy

// Privy dashboard → your app → Settings → Clients → the iOS client's ID.
// Looks like `client-WY...`. Not the same value as the app secret.
PRIVY_CLIENT_ID =

// From polymarket.com → Settings → Builders. Leave empty for no attribution.
POLYMARKET_BUILDER_CODE =

// Builder fee in basis points (0–100 taker, 0–50 maker). Leave empty for none.
POLYMARKET_BUILDER_FEE_BPS =
